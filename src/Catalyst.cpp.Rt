<?R
  source("conf.R")
  c_header();
?>

#include "Catalyst.h"
#include "Global.h"
#include "Solver.h"

#include <catalyst.hpp>

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <string>
#include <vector>

namespace
{
  bool ExportCellData = true;
  bool CatalystInitialized = false;
  std::vector<std::string> CatalystScripts;

  struct CatalystMeshBuffers
  {
    std::vector<unsigned int> flag;

    <?R
    i = !duplicated(NodeTypes$group)
    for (n in rows(NodeTypes[i,])) { ?>
    std::vector<unsigned char> geometry_<?%s n$group ?>;
    <?R } ?>

    <?R for (q in rows(Quantities)) { ifdef(q$adjoint); ?>
    std::vector<<?%s q$type ?>> quantity_<?%s q$name ?>;
    <?R }; ifdef(); ?>
  };

  int CheckCatalystStatus(catalyst_status status, const char* operation)
  {
    if (status == catalyst_status_ok)
      return 0;

    error("Catalyst 2 %s failed with status %d\n", operation,
          static_cast<int>(status));
    return -1;
  }

  lbRegion GetCatalystRegion(Solver& solver)
  {
    lbRegion result = solver.lattice->region;

    // TCLB's PointData representation needs the high-side point owned by the
    // neighbouring rank. Preserve the legacy adaptor's extent convention.
    if (!ExportCellData)
    {
      const lbRegion& total = solver.lattice->mpi.totalregion;
      if (result.dx + result.nx != total.dx + total.nx) result.nx++;
      if (result.dy + result.ny != total.dy + total.ny) result.ny++;
      if (result.dz + result.nz != total.dz + total.nz) result.nz++;
    }

    return result;
  }

  void ExpandPointData(lbRegion oldRegion, lbRegion newRegion,
                       void* data_, std::size_t elementSize)
  {
    int oldChange = -1;
    int chunk = 0;
    int sourceIndex = 0;
    int destinationIndex = 0;
    char* data = static_cast<char*>(data_);

    for (int z = oldRegion.dz + oldRegion.nz; z > oldRegion.dz; --z)
    {
      for (int y = oldRegion.dy + oldRegion.ny; y > oldRegion.dy; --y)
      {
        for (int x = oldRegion.dx + oldRegion.nx; x > oldRegion.dx; --x)
        {
          const int change = newRegion.offset(x - 1, y - 1, z - 1) -
                             oldRegion.offset(x - 1, y - 1, z - 1);
          if (change != oldChange)
          {
            if (oldChange != -1)
            {
              std::memmove(data + destinationIndex * elementSize,
                           data + sourceIndex * elementSize,
                           chunk * elementSize);
            }
            oldChange = change;
            chunk = 0;
          }
          sourceIndex = oldRegion.offset(x - 1, y - 1, z - 1);
          destinationIndex = newRegion.offset(x - 1, y - 1, z - 1);
          ++chunk;
        }
      }
    }

    if (oldChange != 0)
      error("while expanding data for Catalyst PointData output something went wrong\n");
  }

  template <typename ValueType>
  void SetScalarField(conduit_cpp::Node& fields, const char* name,
                      ValueType* values, std::size_t size)
  {
    auto field = fields[name];
    field["association"].set(ExportCellData ? "element" : "vertex");
    field["topology"].set("mesh");
    field["volume_dependent"].set("false");
    field["values"].set_external(values, size);
  }

  template <typename VectorType>
  void SetVectorField(conduit_cpp::Node& fields, const char* name,
                      VectorType* values, std::size_t size)
  {
    auto field = fields[name];
    field["association"].set(ExportCellData ? "element" : "vertex");
    field["topology"].set("mesh");
    field["volume_dependent"].set("false");
    field["values/x"].set_external(&values[0].x, size, 0, sizeof(VectorType));
    field["values/y"].set_external(&values[0].y, size, 0, sizeof(VectorType));
    field["values/z"].set_external(&values[0].z, size, 0, sizeof(VectorType));
  }

  int EnsureCatalystInitialized()
  {
    if (CatalystInitialized)
      return 0;

    if (CatalystScripts.empty())
    {
      error("No scripts provided for Catalyst 2 initialization\n");
      return -1;
    }

    conduit_cpp::Node params;
    for (std::size_t index = 0; index < CatalystScripts.size(); ++index)
    {
      const std::string path = "catalyst/scripts/script" +
                               std::to_string(index) + "/filename";
      params[path].set_string(CatalystScripts[index]);
    }

    // ParaView Catalyst expects the Fortran handle when a non-default
    // communicator is supplied.
    params["catalyst/mpi_comm"].set(
      static_cast<std::int64_t>(MPI_Comm_c2f(MPMD.local)));

    notice("Initializing Catalyst 2 with %d script(s)\n",
           static_cast<int>(CatalystScripts.size()));
    if (CheckCatalystStatus(
          catalyst_initialize(conduit_cpp::c_node(&params)), "initialize") != 0)
      return -1;

    CatalystInitialized = true;
    return 0;
  }

  void BuildCatalystMesh(Solver& solver, conduit_cpp::Node& mesh,
                         CatalystMeshBuffers& buffers)
  {
    lbRegion oldRegion = solver.lattice->region;
    lbRegion region = GetCatalystRegion(solver);
    const std::size_t size = region.size();
    const double spacing = 1.0 / solver.units.alt("m");

    mesh["state/domain_id"].set(static_cast<std::int64_t>(solver.mpi_rank));

    mesh["coordsets/coords/type"].set("uniform");
    mesh["coordsets/coords/dims/i"].set(
      static_cast<std::int64_t>(region.nx + (ExportCellData ? 1 : 0)));
    mesh["coordsets/coords/dims/j"].set(
      static_cast<std::int64_t>(region.ny + (ExportCellData ? 1 : 0)));
    mesh["coordsets/coords/dims/k"].set(
      static_cast<std::int64_t>(region.nz + (ExportCellData ? 1 : 0)));
    mesh["coordsets/coords/origin/x"].set(region.dx * spacing);
    mesh["coordsets/coords/origin/y"].set(region.dy * spacing);
    mesh["coordsets/coords/origin/z"].set(region.dz * spacing);
    mesh["coordsets/coords/spacing/dx"].set(spacing);
    mesh["coordsets/coords/spacing/dy"].set(spacing);
    mesh["coordsets/coords/spacing/dz"].set(spacing);

    mesh["topologies/mesh/type"].set("uniform");
    mesh["topologies/mesh/coordset"].set("coords");

    auto fields = mesh["fields"];

    std::vector<flag_t> nodeTypes(size, 0);
    solver.lattice->GetFlags(region, nodeTypes.data());

    buffers.flag.resize(size, 0);
    for (std::size_t index = 0; index < size; ++index)
      buffers.flag[index] = static_cast<unsigned int>(nodeTypes[index]);
    if (!ExportCellData)
      ExpandPointData(oldRegion, region, buffers.flag.data(), sizeof(unsigned int));
    SetScalarField(fields, "flag", buffers.flag.data(), size);

    <?R
    i = !duplicated(NodeTypes$group)
    for (n in rows(NodeTypes[i,])) { ?>
    buffers.geometry_<?%s n$group ?>.resize(size, 0);
    for (std::size_t index = 0; index < size; ++index)
    {
      buffers.geometry_<?%s n$group ?>[index] = static_cast<unsigned char>(
        (nodeTypes[index] & NODE_<?%s n$group ?>) >> <?%d n$shift ?>);
    }
    if (!ExportCellData)
      ExpandPointData(oldRegion, region,
                      buffers.geometry_<?%s n$group ?>.data(),
                      sizeof(unsigned char));
    SetScalarField(fields, "<?%s n$group ?>",
                   buffers.geometry_<?%s n$group ?>.data(), size);
    <?R } ?>

    <?R for (q in rows(Quantities)) { ifdef(q$adjoint); ?>
    buffers.quantity_<?%s q$name ?>.resize(size);
    solver.lattice->Get<?%s q$name ?>(
      oldRegion, buffers.quantity_<?%s q$name ?>.data(),
      1.0 / solver.units.alt("<?%s q$unit ?>"));
    if (!ExportCellData)
      ExpandPointData(oldRegion, region,
                      buffers.quantity_<?%s q$name ?>.data(),
                      sizeof(<?%s q$type ?>));
    <?R if (q$vector) { ?>
    SetVectorField(fields, "<?%s q$name ?>",
                   buffers.quantity_<?%s q$name ?>.data(), size);
    <?R } else { ?>
    SetScalarField(fields, "<?%s q$name ?>",
                   buffers.quantity_<?%s q$name ?>.data(), size);
    <?R } ?>
    <?R }; ifdef(); ?>
  }
}

namespace CatalystAdaptor
{
  int Initialize(bool exportCellData)
  {
    if (CatalystInitialized)
    {
      error("Cannot reconfigure Catalyst after it has been initialized\n");
      return -1;
    }

    ExportCellData = exportCellData;
    CatalystScripts.clear();
    return 0;
  }

  int AddScript(const char* script)
  {
    if (CatalystInitialized)
    {
      error("Cannot add Catalyst script after initialization: %s\n", script);
      return -1;
    }

    notice("Adding Catalyst 2 script: %s\n", script);
    CatalystScripts.push_back(script);
    return 0;
  }

  int Finalize()
  {
    if (!CatalystInitialized)
      return 0;

    conduit_cpp::Node params;
    const int result = CheckCatalystStatus(
      catalyst_finalize(conduit_cpp::c_node(&params)), "finalize");
    CatalystInitialized = false;
    CatalystScripts.clear();
    return result;
  }

  int CoProcess(Solver& solver, double time,
                unsigned int timeStep, bool lastTimeStep)
  {
    (void)lastTimeStep;
    if (EnsureCatalystInitialized() != 0)
      return -1;

    conduit_cpp::Node execParams;
    auto state = execParams["catalyst/state"];
    state["timestep"].set(static_cast<std::int64_t>(timeStep));
    state["cycle"].set(static_cast<std::int64_t>(timeStep));
    state["time"].set(time);

    auto channel = execParams["catalyst/channels/input"];
    channel["type"].set("mesh");

    CatalystMeshBuffers buffers;
    auto mesh = channel["data"];
    BuildCatalystMesh(solver, mesh, buffers);

    return CheckCatalystStatus(
      catalyst_execute(conduit_cpp::c_node(&execParams)), "execute");
  }
}
